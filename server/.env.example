# =============================================================
# OBRIGATORIO - Banco de Dados
# =============================================================
POSTGRES_DB=trilan_nvr
POSTGRES_USER=trilan
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_FORTE

# =============================================================
# OBRIGATORIO - API
# =============================================================
# URL de conexao com o banco (ajuste se usar DB externo do Dokploy)
DATABASE_URL=postgresql://trilan:TROQUE_ESTA_SENHA_FORTE@db:5432/trilan_nvr

# Chave secreta para assinatura de JWT (gere com: openssl rand -hex 32)
SECRET_KEY=GERE_UMA_CHAVE_SECRETA_AQUI

# Chave Fernet para criptografar senhas no banco (gere com Python):
# from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FERNET_KEY=GERE_UMA_CHAVE_FERNET_AQUI

# Senha do painel administrativo (OBRIGATORIO — nao use senhas fracas em producao)
ADMIN_PASSWORD=TROQUE_ESTA_SENHA_FORTE

# =============================================================
# OPCIONAL - SMTP (envio de e-mail pelo servidor)
# =============================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu.email@gmail.com
SMTP_PASSWORD=sua_senha_de_aplicativo

# =============================================================
# OPCIONAL - CORS
# =============================================================
# Lista de origens permitidas para o dashboard (separadas por virgula).
# Deixe vazio para negar todas as origens cross-origin, ou use * para permitir qualquer uma (nao recomendado em producao).
# Exemplo: CORS_ORIGINS=https://painel.suaempresa.com
CORS_ORIGINS=
